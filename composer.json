{
    "name": "docvault/docvault",
    "description": "DocVault - a minimal document sharing service",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*",
        "erusev/parsedown": "1.7.1",
        "firebase/php-jwt": "5.5.1",
        "guzzlehttp/guzzle": "7.4.0",
        "twig/twig": "3.4.2"
    },
    "autoload": {
        "files": [
            "src/http.php",
            "src/db.php",
            "src/repository.php",
            "src/token.php",
            "src/docs.php",
            "src/search.php",
            "src/convert.php",
            "src/fetch.php",
            "src/settings.php"
        ]
    }
}
